{
  "mcpServers": {
    "hermes": {
      "command": "python3",
      "args": [
        "-m",
        "mcp_server.hermes_server"
      ],
      "env": {
        "HERMES_REPO": "${workspaceFolder}",
        "HERMES_AGENTS_DIR": "${workspaceFolder}/agents",
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  }
}
