{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp",
        "--path",
        "${workspaceFolder}"
      ]
    },
    "hermes": {
      "command": "python3",
      "args": [
        "-m",
        "mcp_server.hermes_server"
      ],
      "env": {
        "HERMES_REPO": "${workspaceFolder}",
        "HERMES_AGENTS_DIR": "${workspaceFolder}/agents",
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    "semgrep": {
      "command": "semgrep",
      "args": ["mcp", "--transport", "stdio", "--agent", "cursor"],
      "env": {
        "SEMGREP_MCP_DISABLE_TRACING": "true"
      }
    }
  }
}
