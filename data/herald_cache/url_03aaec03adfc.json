ock--contentmain--nir-news__widget block--contentmain--nir-news__widget--5816 block--058faf65-3204-4522-b741-af3c333b9f8b block--058faf65-3204-4522-b741-af3c333b9f8b--5816 block block-nir-news block-nir-news__widget\">\n  \n    \n      <section id=\"news\">\n    <div class=\"cont\">\n<div class=\"nir-widget llf-container-fluid-full\">\n    <div class=\"llf-row llf-no-gutters\">\n        <div class=\"llf-col-12\">\n                        <div class=\"nir-widget--content\">\n                                    <div class=\"nir-widget--form\">\n                        <form class=\"nir-widget-form-base\" data-drupal-selector=\"widget-form-base\" action=\"/press-releases\" method=\"get\" id=\"widget-form-base\" accept-charset=\"UTF-8\">\n  <div class=\"nir-widgets--field-container nir-widgets--field-container--yeartimezone js-form-wrapper form-wrapper\" data-drupal-selector=\"edit-38bbbf17da057ca18aed4a13c908503c4953c71b785ca47f0a36850d7c2d384d-year\" id=\"edit-38bbbf17da057ca18aed4a13c908503c4953c71b785ca47f0a36850d7c2d384d-year\"><div class=\"two-col-field form-item js-form-item js-form-type-select form-type-select form-item-38bbbf17da057ca18aed4a13c908503c4953c71b785ca47f0a36850d7c2d384d-year-value form-item-_8bbbf17da057ca18aed4a13c908503c4953c71b785ca47f0a36850d7c2d384d-year-value js-form-item-_8bbbf17da057ca18aed4a13c908503c4953c71b785ca47f0a36850d7c2d384d-year-value\">\n      <label for=\"edit-38bbbf17da057ca18aed4a13c908503c4953c71b785ca47f0a36850d7c2d384d-year-value\">Year</label>\n        <select data-drupal-selector=\"edit-38bbbf17da057ca18aed4a13c908503c4953c71b785ca47f0a36850d7c2d384d-year-value\" id=\"edit-38bbbf17da057ca18aed4a13c908503c4953c71b785ca47f0a36850d7c2d384d-year-value\" name=\"38bbbf17da057ca18aed4a13c908503c4953c71b785ca47f0a36850d7c2d384d_year[value]\" class=\"form-select\"><option value=\"_none\">All</option><option value=\"2026\" selected=\"selected\">2026</option><option value=\"2025\">2025</option><option value=\"2024\">2024</option><option value=\"2023\">2023</option><option value=\"2022\">2022</option><option value=\"2021\">2021</option><option value=\"2020\">2020</option><option value=\"2019\">2019</option><option value=\"2018\">2018</option><option value=\"2017\">2017</option><option value=\"2016\">2016</option><option value=\"2015\">2015</option><option value=\"2014\">2014</option><option value=\"2013\">2013</option><option value=\"2012\">2012</option></select>\n        </div>\n</div>\n<input data-drupal-selector=\"edit-submit\" type=\"submit\" id=\"edit-submit\" name=\"op\" value=\"Filter\" class=\"button button--primary js-form-submit form-submit\" />\n<input data-drupal-selector=\"edit-38bbbf17da057ca18aed4a13c908503c4953c71b785ca47f0a36850d7c2d384d-widget-id\" type=\"hidden\" name=\"38bbbf17da057ca18aed4a13c908503c4953c71b785ca47f0a36850d7c2d384d_widget_id\" value=\"38bbbf17da057ca18aed4a13c908503c4953c71b785ca47f0a36850d7c2d384d\" />\n<input autocomplete=\"off\" data-drupal-selector=\"form-uilz1elac2-dabltr19khjfc5di1gipsckqpqgqyyg\" type=\"hidden\" name=\"form_build_id\" value=\"form-_uIlz1elAC2_dABLtR19KHjFC5di1giPsCKQPQGQYYg\" />\n<input data-drupal-selector=\"edit-widget-form-base\" type=\"hidden\" name=\"form_id\" value=\"widget_form_base\" />\n\n</form>\n\n                    </div>\n                                <div class=\"nir-widget--list  llf-mb-3\">\n                                            <div class=\"articles-wrapper\">\n    \n<article>\n    <a href=\"/news-releases/news-release-details/zymeworks-announces-share-repurchase-program-125-million-its\" aria-label=\"Zymeworks Announces Share Repurchase Program of up to $125 Million of its Common Stock\" >\n                <div class=\"content\">\n                            <h3>Zymeworks Announces Share Repurchase Program of up to $125 Million of its Common Stock</h3>\n            \n                            <p>\n                    VANCOUVER, British Columbia, May 14, 2026 (GLOBE NEWSWIRE) -- Zymeworks Inc. (Nasdaq: ZYME), a biotechnology company managing a portfolio of licensed healthcare assets while developing a diverse pipeline of novel, multifunctional biotherapeutics, today announced that its Board of Directors has\n                </p>\n            \n                            <span>05.14.2026</span>\n                    </div>\n    </a>\n\n    \n            <div class=\"nir-widget--field nir-widget--news--addl-formats\" data-label=\"Additional Formats\">\n\n                                          <div class=\"nir-widgets-file-link\">\n    <a href=\"/node/13766/pdf\" target=\"_blank\">PDF Version</a>\n      </div>\n\n            \n        </div>\n    \n    \n\n\n    \n</article>\n\n    \n<article>\n    <a href=\"/news-releases/news-release-details/zymeworks-announces-participation-upcoming-investor-30\" aria-label=\"Zymeworks Announces Participation in Upcoming Investor Conferences\" >\n                <div class=\"content\">\n                            <h3>Zymeworks Announces Participation in Upcoming Investor Conferences</h3>\n            \n                            <p>\n                    VANCOUVER, British Columbia, May 13, 2026 (GLOBE NEWSWIRE) -- Zymeworks Inc. (Nasdaq: ZYME), a biotechnology company managing a portfolio of licensed healthcare assets while developing a diverse pipeline of novel, multifunctional biotherapeutics, today announced that management will participate in\n                </p>\n            \n                            <span>05.13.2026</span>\n                    </div>\n    </a>\n\n    \n            <div class=\"nir-widget--field nir-widget--news--addl-formats\" data-label=\"Additional Formats\">\n\n                                          <div class=\"nir-widgets-file-link\">\n    <a href=\"/node/13746/pdf\" target=\"_blank\">PDF Version</a>\n      </div>\n\n            \n        </div>\n    \n    \n\n\n    \n</article>\n\n    \n<article>\n    <a href=\"/news-releases/news-release-details/zymeworks-provides-corporate-update-and-reports-first-quarter-3\" aria-label=\"Zymeworks Provides Corporate Update and Reports First Quarter 2026 Financial Results\" >\n                <div class=\"content\">\n                            <h3>Zymeworks Provides Corporate Update and Reports First Quarter 2026 Financial Results</h3>\n            \n                            <p>\n                    Jazz announced U.S. FDA acceptance with Priority Review of Supplemental Biologics License Application (sBLA) for zanidatamab in first-line HER2-positive unresectable locally advanced or metastatic gastroesophageal adenocarcinoma (GEA); PDUFA target action date of August 25, 2026 China\u2019s NMPA has\n                </p>\n            \n                            <span>05.07.2026</span>\n                    </div>\n    </a>\n\n    \n            <div class=\"nir-widget--field nir-widget--news--addl-formats\" data-label=\"Additional Formats\">\n\n                                          <div class=\"nir-widgets-file-link\">\n    <a href=\"/node/13731/pdf\" target=\"_blank\">PDF Version</a>\n      </div>\n\n            \n        </div>\n    \n    \n\n\n    \n</article>\n\n    \n<article>\n    <a href=\"/news-releases/news-release-details/zymeworks-presents-new-phase-1-data-zw191-folate-receptor-alpha\" aria-label=\"Zymeworks Presents New Phase 1 Data for ZW191, a Folate Receptor Alpha-Targeting ADC at AACR Annual Meeting 2026\" >\n                <div class=\"content\">\n                            <h3>Zymeworks Presents New Phase 1 Data for ZW191, a Folate Receptor Alpha-Targeting ADC at AACR Annual Meeting 2026</h3>\n            \n                            <p>\n                    ZW191 demonstrates encouraging anti-tumor activity in heavily pretreated ovarian and endometrial cancers, regardless of FR\u03b1 expression Confirmed objective response rate (cORR) of 61% at doses 6.4-9.6 mg/kg in platinum resistant ovarian cancer Median duration of response was not reached at the time\n                </p>\n            \n                            <span>04.21.2026</span>\n                    </div>\n    </a>\n\n    \n            <div class=\"nir-widget--field nir-widget--news--addl-formats\" data-label=\"Additional Formats\">\n\n                                          <div class=\"nir-widgets-file-link\">\n    <a href=\"/node/13721/pdf\" target=\"_blank\">PDF Version</a>\n      </div>\n\n            \n        </div>\n    \n    \n\n\n    \n</article>\n\n    \n<article>\n    <a href=\"/news-releases/news-release-details/zymeworks-presents-new-preclinical-data-aacr-2026-highlighting\" aria-label=\"Zymeworks Presents New Preclinical Data at AACR 2026 Highlighting Broad Antibody-Drug Conjugate Programs Including Novel RAS-Targeting Platform\" >\n                <div class=\"content\">\n                            <h3>Zymeworks Presents New Preclinical Data at AACR 2026 Highlighting Broad Antibody-Drug Conjugate Programs Including Novel RAS-Targeting Platform</h3>\n            \n                            <p>\n                    Six poster presentations showcase Zymeworks\u2019 next-generation ADC programs, including multiple first-in-class pan-RAS inhibitor ADCs\u00a0 Data highlight efficacy, tumor-selective delivery, and favorable tolerability across multiple solid tumor models New programs include Ly6E, CLDN18.2, and\n                </p>\n            \n                            <span>04.17.2026</span>\n                    </div>\n    </a>\n\n    \n            <div class=\"nir-widget--field nir-widget--news--addl-formats\" data-label=\"Additional Formats\">\n\n                                          <div class=\"nir-widgets-file-link\">\n    <a href=\"/node/13716/pdf\" target=\"_blank\">PDF Version</a>\n      </div>\n\n            \n        </div>\n    \n    \n\n\n    \n</article>\n\n    \n<article>\n    <a href=\"/news-releases/news-release-details/zymeworks-report-first-quarter-2026-financial-results-and-host\" aria-label=\"Zymeworks to Report First Quarter 2026 Financial Re