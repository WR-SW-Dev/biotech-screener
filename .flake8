[flake8]
max-line-length = 120
extend-ignore = E501,W503,E203,E266,E402,E741
exclude =
    .git,
    __pycache__,
    build,
    dist,
    *.egg-info,
    .venv,
    .venv-wsl,
    venv,
    vendor,
    node_modules,
    deprecated,
    data,
    cache,
    backtest_results,
    production_data,
    artifacts,
    mnt,
    output
per-file-ignores =
    # F401/F841 unused imports/vars are common in test fixtures and re-export
    # stubs; E712 (== True) is intentional in strict boolean tests;
    # F541 (f-string without placeholder) and E741 (ambiguous 'l') appear in
    # generated or parametrized test patterns.
    tests/*.py:E501,E302,E303,F401,F841,E712,F541,E741,F811
    tests/integration/*.py:E501,E302,E303,F401,F841,E712,F541,E741,F811
    tests/providers/*.py:E501,E302,E303,F401,F841,E712,F541,E741,F811
    # F-strings without placeholders and unused imports are widespread in this
    # health-calibration script; fix deferred until the file is refactored.
    run_phase2_health_calibration.py:F401,F541
    cusip_resolver.py:F601,F841,W291,W293
    sec_13f/cusip_resolver.py:F601,F841,W291,W293
    optimization/optimize_weights_scipy.py:F401,F841
    optimization/validate_weights.py:F401,F841,F541
    pos_ablation_framework.py:F401
    run_screen.py:F401,F541,F811,E731,E231
    scripts/run_screen_from_bundle.py:F401,F821,F841
    src/scripts/clean_universe.py:F401
    scripts/enrich_market_data_momentum.py:E231
    scripts/build_news_digest.py:F841
    scripts/extract_13f_history.py:F841
    tools/sanity_compare_results.py:E231
    tools/weekly_health_packet.py:E231
    common/data_consistency.py:F402
    common/options_verdict_features.py:E741
    scripts/audit_fda_coverage.py:E231
    scripts/extract_replay_fixtures.py:E231
    tools/backtest_options_monitor_v11.py:E741
    tools/build_options_verdict.py:E741
    tools/train_options_probability_model.py:E741
